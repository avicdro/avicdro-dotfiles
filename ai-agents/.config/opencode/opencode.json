{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "reactbits": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
        "disabled": true
      },
      "notion": {
        "type": "local",
        "command": ["npx", "-y", "mcp-remote", "https://mcp.notion.com/mcp"],
        "disabled": true
      },
      "pencil": {
        "type": "local",
        "command": [
          "/mnt/c/Users/avicd/AppData/Local/Programs/Pencil/resources/app.asar.unpacked/out/mcp-server-windows-x64.exe",
          "--app",
          "desktop"
        ],
        "environment": {},
        "disabled": true
      }
    }
  },
  "agents": {
    "dev-flow-planner": {
      "description": "Dev-Flow Planner - Planifica en read-only, espera tu aprobacion y orquesta el bucle build-review",
      "mode": "primary",
      "system": "{file:~/.config/opencode/agents/dev-flow-planner.md}",
      "color": "#fabd2f",
      "request": {
        "body": { "temperature": 0.2 }
      },
      "steps": 150,
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "dev-flow-builder", "effect": "allow" },
        { "action": "subagent", "resource": "dev-flow-reviewer", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "dev-flow-builder": {
      "mode": "subagent",
      "system": "{file:~/.config/opencode/agents/dev-flow-builder.md}"
    },
    "dev-flow-reviewer": {
      "mode": "subagent",
      "system": "{file:~/.config/opencode/agents/dev-flow-reviewer.md}"
    }
  }
}
