{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "permission": "allow",
  "mcp": {
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.notion.com/mcp"],
      "enabled": false
    },
    "pencil": {
      "type": "local",
      "command": [
        "/mnt/c/Users/avicd/AppData/Local/Programs/Pencil/resources/app.asar.unpacked/out/mcp-server-windows-x64.exe",
        "--app",
        "desktop"
      ],
      "environment": {},
      "enabled": true
    }
  },
  "agent": {
    "dev-flow-planner": {
      "description": "Dev-Flow Planner - Planifica en read-only, espera tu aprobacion y orquesta el bucle build-review",
      "mode": "primary",
      "prompt": "{file:~/.config/opencode/agents/dev-flow-planner.md}",
      "color": "#fabd2f",
      "temperature": 0.2,
      "maxSteps": 150,
      "permission": {
        "task": {
          "dev-flow-builder": "allow",
          "dev-flow-reviewer": "allow"
        },
        "skill": "allow",
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    },
    "dev-flow-builder": {
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/agents/dev-flow-builder.md}"
    },
    "dev-flow-reviewer": {
      "mode": "subagent",
      "prompt": "{file:~/.config/opencode/agents/dev-flow-reviewer.md}"
    }
  }
}
