{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "yellow", "orange"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.faint",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$disabled": "$text.faint"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.faint",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.yellow.200" }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#3c3836ff",
        "high": "#504945ff",
        "max": "#665c54ff"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.300",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.300" }
      },
      "formfield": { "base": "#282828b3" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "$hue.neutral.500" },
    "scrollbar": { "base": "$hue.neutral.500" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#3b4137",
        "removed": "#452f2d",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$hue.neutral.400",
        "background": { "added": "#32382e", "removed": "#3a2826" }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.red.100",
      "function": "$hue.green.100",
      "variable": "$hue.blue.100",
      "string": "$hue.yellow.100",
      "number": "$hue.purple.100",
      "type": "$hue.green.200",
      "operator": "$hue.orange.100",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.blue.100",
      "link": "$hue.green.100",
      "linkText": "$hue.green.100",
      "code": "$hue.yellow.100",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.purple.100",
      "strong": "$hue.orange.100",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.blue.100",
      "listEnumeration": "$hue.green.100",
      "image": "$hue.green.100",
      "imageText": "$hue.green.100",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
