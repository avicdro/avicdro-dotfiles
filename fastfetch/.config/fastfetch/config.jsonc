{
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "constants": [
            "────────────────────────────────────────"
        ],
        "key": {
            "type": "icon",
            "paddingLeft": 1
        },
        "size": {
            "ndigits": 1,
            "maxPrefix": "GB"
        },
        "color": {
            "keys": "cyan"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "cyan"
        },
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "red",
                "host": "blue"
            }
        },
        {
            "type": "custom",
            "format": "{$1}",
            "outputColor": "cyan"
        },
        {
            "type": "custom",
            "format": "  {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#38}  {#39}  {#37}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}"
        },
        "break",
        {
            "type": "os",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "keyColor": "yellow"
        },
        {
            "type": "host",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "keyColor": "green"
        },
        "break",
        {
            "type": "display",
            "keyColor": "blue",
            "compactType": "original"
        },
        {
            "type": "wm",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "keyColor": "magenta"
        },
        {
            "type": "icons",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "cpu",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "keyColor": "yellow",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "swap",
            "keyColor": "yellow",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "keyColor": "red"
        },
        "break",
        {
            "type": "localip",
            "keyColor": "cyan",
            "compact": true
        },
        {
            "type": "locale",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle",
            "block": {
                "width": 3
            }
        }
    ]
}